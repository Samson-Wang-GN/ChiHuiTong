page{background:#f2f3f5;color:#1d2129;font-size:16px;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}
.page{padding:16px 16px calc(24px + env(safe-area-inset-bottom));box-sizing:border-box;min-height:100vh}.headline{font-size:24px;font-weight:600;margin:8px 0 16px}.card{padding:16px;background:#fff;border-radius:8px;margin:16px 0;overflow:hidden}.card-title{font-size:18px;font-weight:600;margin-bottom:8px;overflow-wrap:anywhere}.notice,.error{padding:12px;border-radius:4px;margin:12px 0;line-height:1.6;font-size:14px}.notice{background:#e8f3ff;color:#165dff}.error{background:#ffece8;color:#cb272d;overflow-wrap:anywhere}.error button{display:block;margin-top:8px}.muted,.loading{color:#6b7785;font-size:14px}.loading{padding:8px}.fact{display:flex;justify-content:space-between;gap:16px;padding:10px 0;border-bottom:1px solid #f2f3f5;line-height:1.5}.fact>text:last-child{flex:1;text-align:right;overflow-wrap:anywhere}.fact>.muted{min-width:78px}.line{font-size:14px;line-height:1.7;color:#4e5969;overflow-wrap:anywhere}.badge{display:inline-block;background:#e8f3ff;color:#165dff;font-size:12px;padding:3px 8px;border-radius:4px;margin-bottom:8px}.actions{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}.actions button{flex:1;min-width:128px;margin:0}.primary,.secondary,.danger{font-size:16px;min-height:44px;line-height:1.5;padding:10px 12px;border-radius:4px;white-space:normal;box-sizing:border-box}.primary{background:#165dff;color:#fff;margin:16px 0}.secondary{background:#e8f3ff;color:#165dff}.danger{background:#ffece8;color:#cb272d}button::after{border:0}button[disabled]{background:#f2f3f5!important;color:#a9aeb8!important}.field{margin-bottom:18px}.label{display:block;font-size:14px;margin-bottom:8px}.required{color:#f53f3f}.input{box-sizing:border-box;background:#f2f3f5;border:1px solid #e5e6eb;border-radius:4px;min-height:44px;padding:10px 12px;line-height:24px;font-size:16px}.check{display:flex;align-items:center;min-height:44px;font-size:14px;line-height:1.5}.tabs{white-space:nowrap;border-bottom:1px solid #e5e6eb;margin:12px 0}.tab{display:inline-block;background:transparent;font-size:14px;border-radius:0;min-height:44px;color:#4e5969;padding:8px 12px}.tab.selected{color:#165dff;border-bottom:2px solid #165dff}.empty{text-align:center;padding:36px 0;color:#86909c}.pagination{display:flex;align-items:center;justify-content:space-between;font-size:12px;gap:8px;margin-top:20px}.pagination button{margin:0;font-size:14px;min-height:44px}.cover{width:100%;height:200px;border-radius:8px}.map{width:100%;height:230px;margin-top:12px}.qr-card{text-align:center}
