{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["miniprogram-api-typings"],
    "lib": ["ES2020"],
    "rootDir": "src",
    "outDir": "compiled",
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts"]
}
