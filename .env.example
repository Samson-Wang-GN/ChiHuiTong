# Static prototypes need no secrets. Backend requires all marked settings.
# Generate independent random secrets outside Git; never use example values.
CHT_ENVIRONMENT=production
CHT_SECRET_KEY=
# Comma-separated Fernet keys; newest first. Keep older keys during rotation.
CHT_FIELD_KEYS=
CHT_PHONE_INDEX_KEY=
CHT_ALLOWED_HOSTS=localhost,127.0.0.1
CHT_DB_NAME=chihuitong
CHT_DB_USER=ubuntu
CHT_DB_PASSWORD=
CHT_DB_HOST=/home/ubuntu/ChiHuiTong/runtime/pgsocket
CHT_DB_PORT=55432
CHT_TEST_DB_NAME=test_chihuitong
CHT_PRIVATE_STORAGE=/home/ubuntu/ChiHuiTong/runtime/private-files
CHT_SMS_BACKEND=chihuitong.integrations.sms.DisabledSMS
CHT_TENCENT_MAP_KEY=
# To enable real SMS use chihuitong.integrations.tencent_sms.TencentSMS,
# configure credentials outside Git and activate pre-approved templates in platform settings.
CHT_TENCENT_SMS_SECRET_ID=
CHT_TENCENT_SMS_SECRET_KEY=
CHT_TENCENT_SMS_SDK_APP_ID=
CHT_TENCENT_SMS_REGION=ap-beijing
# Direct-merchant WeChat Pay APIv3. Missing configuration keeps real payment disabled.
CHT_WECHAT_PAY_ENABLED=false
CHT_WXPAY_MCHID=
CHT_WXPAY_APPID=
CHT_WXPAY_CERTIFICATE_SERIAL=
# Absolute runtime paths; private key file permissions must be 0600.
CHT_WXPAY_PRIVATE_KEY_PATH=
CHT_WXPAY_PUBLIC_KEY_ID=
# JSON mapping trusted PUB_KEY_ID to absolute public-key paths; supports rotation.
CHT_WXPAY_PUBLIC_KEYS=
CHT_WXPAY_API_V3_KEY=
CHT_WXPAY_NOTIFY_URL=
